# ClassFlow Automation - the settings a deployment needs.
#
# Copy the names, not the values: every one below is a placeholder. In Coolify these go in the
# resource's Environment Variables, not in a file inside a container - a container is thrown away on
# every deployment and anything edited inside one goes with it.
#
# Nothing here is committed with a real value. The three marked SECRET are generated once and kept
# with the backups; losing CENTRAL_SECRETS_KEY makes every stored LMS password unreadable.

# ----------------------------------------------------------------------------- database
POSTGRES_USER=classflow
# SECRET. openssl rand -base64 24
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=classflow

# ----------------------------------------------------------------------------- backend
# The domain the dashboard answers on. Coolify uses it to route and to get a certificate.
SERVICE_FQDN_BACKEND=classflow.example.com

# production refuses any request the proxy did not mark as https, which is what you want behind
# Coolify. Use development only on a throwaway machine, where plain http is wanted.
CENTRAL_ENVIRONMENT=production

# Which addresses uvicorn believes about X-Forwarded-Proto. "*" trusts whatever reached the
# container, which is safe only because nothing but Coolify's proxy can reach it - the backend has
# no published port. If you expose it directly, this must name the proxy instead.
CENTRAL_FORWARDED_ALLOW_IPS=*

# The SHA-256 of an API client key, comma separated. Never a key itself. This is retained for
# tightly controlled internal API clients; Google Sheet sync does not use it.
# Make one with:  python -m central_backend.cli new-api-key
CENTRAL_CLIENT_API_KEY_HASHES=replace-with-a-sha256-hash

# SECRET. 32 random bytes, base64. Encrypts the LMS passwords users keep on the server.
# Make one with:  python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep it with the database backups: a backup without this key cannot be read.
CENTRAL_SECRETS_KEY=replace-me

# false means the admin creates every account; the sign-up page says so.
CENTRAL_ALLOW_REGISTRATION=false
CENTRAL_SESSION_HOURS=8

# Optional: turns on "Match with AI" for attendance. Without it the button is hidden and the step
# answers 409, which is a working state, not a broken one.
CENTRAL_AI_API_KEY=
CENTRAL_AI_MODEL=openai/gpt-4o-mini
CENTRAL_AI_BASE_URL=https://openrouter.ai/api/v1

# ----------------------------------------------------------------------------- Google Sheets (read-only sync)
# Create an OAuth Web application in Google Cloud. Add the callback below as an authorized redirect
# URL, then enter the actual values in Coolify's secret environment. Never put a real secret in Git.
CENTRAL_GOOGLE_OAUTH_CLIENT_ID=
CENTRAL_GOOGLE_OAUTH_CLIENT_SECRET=
CENTRAL_GOOGLE_OAUTH_REDIRECT_URI=https://classflow.example.com/api/v1/google-sheets/callback

# ----------------------------------------------------------------------------- worker
# The backend's public https address - the same one a browser uses. Not http://backend:8000: with
# CENTRAL_ENVIRONMENT=production the backend refuses anything that did not arrive over https.
ZAA_BACKEND_URL=https://classflow.example.com

# What this worker is called on the Server page. Worth setting: the default is the container id.
ZAA_WORKER_NAME=cloud-worker-1

# SECRET, and single-use. Made on the server with:
#   python -m central_backend.cli create-enrollment-token --label cloud-worker-1
# Only read when the state volume has no device token yet. Clear it from Coolify once the worker
# has enrolled - it is spent, and leaving it there only invites confusion at the next deployment.
ZAA_ENROLLMENT_TOKEN=

# A worker runs one class at a time; this caps its memory. Two classes at once is a second worker
# service with its own volume, never --scale (see COOLIFY_DEPLOYMENT.md).
ZAA_WORKER_MEMORY=2g

# Zoom's web client may refuse a headless browser; that has not been tested against live Zoom. If it
# does, set this false and the container's Xvfb gives Chromium a display.
ZAA_HEADLESS=true

# ----------------------------------------------------------------------------- shared
TZ=Africa/Cairo

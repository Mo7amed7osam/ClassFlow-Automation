# Settings for running the backend on a cloud box, for development only.
#
#   cd Backend && set -a && . ./cloud.env && set +a
#
# Every name here is documented with its default in Backend/README.md. The values are development
# values: a local PostgreSQL, http allowed, and an API key generated for this file alone. Nothing
# here reaches a real deployment.
#
# api.env and api_key.env in the repository root are the operator's own local scrollback, kept for
# reference while the cloud work runs. Both must be rotated and removed afterwards; see CLOUD.md.

# A PostgreSQL on the same box. Scripts/cloud-setup.sh installs the binaries; create the database
# with:  initdb -D /tmp/pg -U postgres -A trust && pg_ctl -D /tmp/pg -o "-p 5439" -l /tmp/pg.log start
CENTRAL_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5439/postgres

# development allows plain http/ws and serves /docs. Never production on a throwaway box: in
# production every non-https request is refused with 403 and nothing will answer.
CENTRAL_ENVIRONMENT=development

# The SHA-256 of the API key a client may send as X-API-Key, never the key itself. This hash is
# sha256("zaak_cloud-dev-key-not-a-real-secret-0000000"), a key that exists only for local runs, so
# send that string as X-API-Key while developing.
CENTRAL_CLIENT_API_KEY_HASHES=cd401a7ba98fd14c80de76be2cc6e120f4e97cca93d12773f566daf94345c835

# Where the built dashboard is. Build it with: cd Dashboard && npm run build
CENTRAL_DASHBOARD_DIST=../Dashboard/dist

# Timings, all at their documented defaults; listed so they are easy to change while testing.
CENTRAL_HEARTBEAT_INTERVAL_SECONDS=30
CENTRAL_DEVICE_STALE_SECONDS=90
CENTRAL_ASSIGNMENT_ACK_TIMEOUT_SECONDS=60
CENTRAL_RUNNING_ORPHAN_TIMEOUT_SECONDS=1800
CENTRAL_BUSY_RETRY_DELAY_SECONDS=60
CENTRAL_SESSION_HOURS=8
CENTRAL_ALLOW_REGISTRATION=true

# Encrypts the LMS passwords users keep on the server. A throwaway value: any data written under it
# is unreadable once it changes, which is fine for a development database and never for a real one.
CENTRAL_SECRETS_KEY=Y2xvdWQtZGV2ZWxvcG1lbnQta2V5LTMyLWJ5dGVzISE=

# "Match with AI" for attendance. Left empty on purpose: without it the button is hidden and the
# step answers 409, which is the correct behaviour to develop against. Do not paste a real key into
# a committed file; export it in the shell for the one session that needs it.
CENTRAL_AI_API_KEY=
CENTRAL_AI_MODEL=openai/gpt-4o-mini
CENTRAL_AI_BASE_URL=https://openrouter.ai/api/v1

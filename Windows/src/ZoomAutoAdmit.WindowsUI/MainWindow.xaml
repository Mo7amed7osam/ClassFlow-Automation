<Window x:Class="ZoomAutoAdmit.WindowsUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ZoomAutoAdmit.WindowsUI.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
Title="Zoom Auto Admit" Icon="Assets/app.ico" Width="1440" Height="820" MinWidth="1100" MinHeight="720" WindowStyle="None" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource AppFont}" FontSize="14">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
<Window.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Dark.xaml"/><ResourceDictionary Source="Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
<CollectionViewSource x:Key="NavigationSource" Source="{Binding FilteredNavigation}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Section"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
<Style x:Key="NavigationItem" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="10,9"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></Window.Resources>
<Border CornerRadius="12" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<!-- The reference paints three page glows behind everything: blue top-left, violet top-right,
     green bottom-centre. They sit under the sidebar exactly as the CSS background does. -->
<Ellipse Grid.ColumnSpan="2" Width="900" Height="500" Fill="{DynamicResource GlowBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-335,-316,0,0" IsHitTestVisible="False"/>
<Ellipse Grid.ColumnSpan="2" Width="700" Height="420" Fill="{DynamicResource GlowPurpleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-210,-235,0" IsHitTestVisible="False"/>
<Ellipse Grid.ColumnSpan="2" Width="600" Height="400" Fill="{DynamicResource GlowGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-200" IsHitTestVisible="False"/>
<Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Margin="{DynamicResource SidebarMargin}" CornerRadius="{DynamicResource SidebarCorner}"><Grid Margin="14,18,14,14">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,30"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource PrimaryBrush}"><Viewbox Margin="11"><Path Data="M2,4 L15,4 Q17,4 17,6 L17,16 Q17,18 15,18 L2,18 Q0,18 0,16 L0,6 Q0,4 2,4 M17,9 L24,5 L24,17 L17,13" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"/></Viewbox></Border>
<StackPanel Grid.Column="1"><TextBlock Text="Zoom Auto Admit AI" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Windows workspace" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
<Button Grid.Row="1" Style="{DynamicResource PrimaryButton}" Command="{Binding ShowStartMeetingCommand}" Margin="0,0,0,16" Padding="12,13"><TextBlock Text="▶   Start Automation" Foreground="White" TextAlignment="Center" FontWeight="SemiBold"/></Button>
<ListBox Grid.Row="2" ItemsSource="{Binding Source={StaticResource NavigationSource}}" SelectedItem="{Binding SelectedNavigation}" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workspace navigation">
<ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="6,12,0,7"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"/></Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel Grid.Row="3" Margin="0,15,0,0"><Border Style="{DynamicResource Card}" Padding="12"><StackPanel><TextBlock Text="●  Local workspace" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding Dashboard.MonitoringStatus}" Style="{DynamicResource Muted}" Margin="13,5,0,0"/></StackPanel></Border>
<Grid Margin="8,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource PrimaryBrush}" Width="27" Height="27" CornerRadius="14"><TextBlock Text="A" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Workspace" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="On this device" Style="{DynamicResource Muted}" FontSize="9" Margin="0,3,0,0"/></StackPanel></Grid>
</StackPanel></Grid></Border>
<Grid Grid.Column="1" Margin="20,0,20,16"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" LastChildFill="False" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><StackPanel.ToolTip><TextBlock><Run Text="Turn this off to stop letting people in."/><LineBreak/><Run Text="The meeting stays open; nobody is admitted until you switch it back on."/></TextBlock></StackPanel.ToolTip><ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding IsAdmitting, Mode=TwoWay}" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" AutomationProperties.Name="Toggle auto admit"/><TextBlock Text="{Binding AdmissionStateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmitting}" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding AdmittedToday}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,3,0" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="today" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
<Button Click="PickDesign" ToolTip="Choose the look of the app" AutomationProperties.Name="Choose design" Padding="12,2" Background="Transparent" BorderThickness="0">
<StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="DesignName" Text="Midnight" FontSize="12" VerticalAlignment="Center"/><TextBlock Text=" ⌄" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
<Button.ContextMenu><ContextMenu>
<MenuItem Tag="Midnight" Click="ChooseDesign"><MenuItem.Icon><Border Width="15" Height="15" CornerRadius="5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B7CF6" Offset="0"/><GradientStop Color="#8B5CF6" Offset="1"/></LinearGradientBrush></Border.Background></Border></MenuItem.Icon><MenuItem.Header><TextBlock><Run Text="Midnight" Foreground="#7C6CF7" FontWeight="SemiBold"/><Run Text="  deep navy, blue to violet" Foreground="#8C8C96"/></TextBlock></MenuItem.Header></MenuItem>
<MenuItem Tag="Ice" Click="ChooseDesign"><MenuItem.Icon><Border Width="15" Height="15" CornerRadius="5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#60A5FA" Offset="0"/><GradientStop Color="#2563EB" Offset="1"/></LinearGradientBrush></Border.Background></Border></MenuItem.Icon><MenuItem.Header><TextBlock><Run Text="Ice" Foreground="#2E7BF6" FontWeight="SemiBold"/><Run Text="  white paper, cool blue" Foreground="#8C8C96"/></TextBlock></MenuItem.Header></MenuItem>
<MenuItem Tag="Teal" Click="ChooseDesign"><MenuItem.Icon><Border Width="15" Height="15" CornerRadius="5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2DD4BF" Offset="0"/><GradientStop Color="#0D9488" Offset="1"/></LinearGradientBrush></Border.Background></Border></MenuItem.Icon><MenuItem.Header><TextBlock><Run Text="Deep teal" Foreground="#12A594" FontWeight="SemiBold"/><Run Text="  blue-green with mint" Foreground="#8C8C96"/></TextBlock></MenuItem.Header></MenuItem>
<MenuItem Tag="Slate" Click="ChooseDesign"><MenuItem.Icon><Border Width="15" Height="15" CornerRadius="5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FBBF24" Offset="0"/><GradientStop Color="#D97706" Offset="1"/></LinearGradientBrush></Border.Background></Border></MenuItem.Icon><MenuItem.Header><TextBlock><Run Text="Warm slate" Foreground="#E08A0B" FontWeight="SemiBold"/><Run Text="  warm charcoal with amber" Foreground="#8C8C96"/></TextBlock></MenuItem.Header></MenuItem>
</ContextMenu></Button.ContextMenu>
</Button>
<Button Content="☼" Click="ToggleTheme" ToolTip="Switch light / dark" AutomationProperties.Name="Toggle theme" Padding="10,2" Background="Transparent" BorderThickness="0"/>
<Button Content="—" Click="MinimizeWindow" AutomationProperties.Name="Minimize" Padding="10,2" Background="Transparent" BorderThickness="0"/>
<Button Content="□" Click="MaximizeWindow" AutomationProperties.Name="Maximize or restore" Padding="10,2" Background="Transparent" BorderThickness="0"/>
<Button Content="×" Click="CloseWindow" AutomationProperties.Name="Close" Padding="10,2" Background="Transparent" BorderThickness="0"/>
</DockPanel>
<Grid Grid.Row="1" Margin="0,4,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions><StackPanel><Border Style="{DynamicResource Badge}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding SelectedNavigation.Section, FallbackValue=MAIN, TargetNullValue=MAIN}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/></StackPanel></Border><TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeading}"/><TextBlock Text="{Binding PageSubtitle}" Style="{DynamicResource PageLead}"/></StackPanel>
<Grid Grid.Column="1" VerticalAlignment="Top"><TextBox Text="{Binding NavigationSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search navigation pages" AutomationProperties.Name="Search pages" Padding="13,10" Margin="0"/><TextBlock Text="⌕  Search pages…" Margin="13,10" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NavigationSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
</Grid>
<TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
<TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></ControlTemplate></TabControl.Template>
<TabItem Header="Overview"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:OverviewView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Start Meeting"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:StartMeetingView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Accounts"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:AccountsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Schedules"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:SchedulesView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Logs"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:LogsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Legacy students"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><Border Style="{DynamicResource Card}" Padding="8"><views:StudentsView DataContext="{Binding Students}"/></Border></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Groups &amp; Students"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><Border Style="{DynamicResource Card}" Padding="14"><views:GroupRosterView DataContext="{Binding Roster}"/></Border></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Meetings"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:MeetingsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Attendance"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:AttendanceView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="AI Matching"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:MatchingView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Waiting Room"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:WaitingRoomView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Settings"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><Border Style="{DynamicResource Card}"><StackPanel MaxWidth="800" HorizontalAlignment="Left">
<TextBlock Text="Settings" Style="{DynamicResource PageTitle}"/><TextBlock Text="How the app looks. None of this changes a meeting, an account or a schedule." Style="{DynamicResource Muted}" Margin="0,8,0,26"/>
<TextBlock Text="Appearance" Style="{DynamicResource CardTitle}"/><TextBlock Text="Pick a design from the button at the top of the window. These two switch the current design between night and day." Style="{DynamicResource Muted}" Margin="0,0,0,12"/><UniformGrid Columns="2" Margin="-3,0,0,18"><Button Content="☾   Night" Click="UseDarkTheme" Padding="20,16"/><Button Content="☼   Day" Click="UseLightTheme" Padding="20,16"/></UniformGrid>
<CheckBox Content="Show a soft trail behind the pointer" IsChecked="{Binding IsEffectEnabled, ElementName=GhostCursor}" Margin="0,0,0,16"/>
<TextBlock Text="Where your data is kept" Style="{DynamicResource CardTitle}"/><TextBlock Text="%LOCALAPPDATA%\ZoomAutoAdmit" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,22"/>
<TextBlock Text="AI key" Style="{DynamicResource CardTitle}"/><TextBlock Text="Your key lives in Windows Credential Manager, never in a file here. Nothing on this page contacts the provider." Style="{DynamicResource Muted}"/>
<Button Content="Set up the key" Command="{Binding NavigateCommand}" CommandParameter="9" HorizontalAlignment="Left" Margin="0,12"/>
<Border Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="18" Margin="0,25,0,0"><TextBlock Text="Everything on this page is remembered for this computer only." Style="{DynamicResource Muted}"/></Border>
</StackPanel></Border></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="AI Engine"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:AiEngineView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Session Roles"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:SessionRolesView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
</TabControl></Grid>
<views:GhostCursorOverlay x:Name="GhostCursor" Grid.ColumnSpan="2" Panel.ZIndex="100"/>
</Grid></Border></Window>

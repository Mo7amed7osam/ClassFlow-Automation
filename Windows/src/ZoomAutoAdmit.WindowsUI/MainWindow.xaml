<Window x:Class="ZoomAutoAdmit.WindowsUI.MainWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ZoomAutoAdmit.WindowsUI.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
Title="Zoom Auto Admit" Icon="Assets/app.ico" Width="1360" Height="860" MinWidth="720" MinHeight="540" WindowStyle="None" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource AppFont}" FontSize="14">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
<Window.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Light.xaml"/><ResourceDictionary Source="Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
<CollectionViewSource x:Key="NavigationSource" Source="{Binding FilteredNavigation}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Section"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
<!-- Texts that only fit in the wide sidebar; the narrow one keeps the icons. -->
<Style x:Key="WideOnly" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
<Style x:Key="NavigationItem" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="ToolTip" Value="{Binding Title}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="Frame" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" Margin="-2,0,0,0"/></Grid><ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="1"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Padding" Value="11,4"/><Setter Property="Margin" Value="1,0"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
</ResourceDictionary></Window.Resources>
<Border CornerRadius="10" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource StrongLineBrush}" BorderThickness="1" ClipToBounds="True"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="{DynamicResource SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<!-- Sidebar -->
<Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><Grid x:Name="SidebarBody" Margin="12,14,12,12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="4,0,0,18">
<Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource PrimaryBrush}"><Viewbox Margin="9"><Path Data="M2,4 L15,4 Q17,4 17,6 L17,16 Q17,18 15,18 L2,18 Q0,18 0,16 L0,6 Q0,4 2,4 M17,9 L24,5 L24,17 L17,13" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"/></Viewbox></Border>
<StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource WideOnly}"><TextBlock Text="Zoom Auto Admit" FontSize="14.5" FontWeight="SemiBold"/><TextBlock Text="Classes, admits and attendance" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/></StackPanel>
</StackPanel>
<Button Grid.Row="1" Style="{DynamicResource PrimaryButton}" Command="{Binding ShowStartMeetingCommand}" Margin="0,0,0,10" Padding="10,10" ToolTip="Start a meeting now" AutomationProperties.Name="Start Automation">
<StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="Start Automation" Foreground="White" FontWeight="SemiBold" Margin="9,0,0,0" Style="{StaticResource WideOnly}"/></StackPanel></Button>
<Grid Grid.Row="2" Margin="0,0,0,6" Style="{StaticResource WideOnly}"><TextBox Text="{Binding NavigationSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search navigation pages" AutomationProperties.Name="Search pages" Padding="30,7,8,7" Margin="0"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SubtleBrush}"/><TextBlock Text="Search pages" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource SubtleBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NavigationSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<ListBox Grid.Row="3" ItemsSource="{Binding Source={StaticResource NavigationSource}}" SelectedItem="{Binding SelectedNavigation}" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workspace navigation">
<ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Grid><TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" Margin="10,14,0,5"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Height="1" Background="{DynamicResource LineBrush}" Margin="8,10,8,6"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></Grid></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<Border Grid.Row="4" Margin="0,10,0,0" Padding="10" CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Style="{StaticResource WideOnly}"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/><TextBlock Text="This PC" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel><TextBlock Text="{Binding Dashboard.MonitoringStatus}" Style="{DynamicResource Muted}" FontSize="11.5" Margin="14,3,0,0"/></StackPanel></Border>
</Grid></Border>

<!-- Page -->
<Grid Grid.Column="1" x:Name="PageArea" Margin="28,0,24,18"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" LastChildFill="False">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<Border CornerRadius="99" Padding="10,4,12,4" Margin="0,0,10,0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.ToolTip><TextBlock><Run Text="Turn this off to stop letting people in."/><LineBreak/><Run Text="The meeting stays open; nobody is admitted until you switch it back on."/></TextBlock></StackPanel.ToolTip><ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding IsAdmitting, Mode=TwoWay}" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" AutomationProperties.Name="Toggle auto admit" Width="34" Height="19"/><TextBlock Text="{Binding AdmissionStateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmitting}" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Width="1" Height="14" Background="{DynamicResource LineBrush}" Margin="10,0"/><TextBlock Text="{Binding AdmittedToday}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text=" today" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
<Button Click="ToggleTheme" ToolTip="Night / day" AutomationProperties.Name="Toggle theme" Style="{StaticResource ChromeButton}"><TextBlock x:Name="ThemeGlyph" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MutedBrush}"/></Button>
<Button Click="MinimizeWindow" AutomationProperties.Name="Minimize" Style="{StaticResource ChromeButton}"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Button>
<Button Click="MaximizeWindow" AutomationProperties.Name="Maximize or restore" Style="{StaticResource ChromeButton}"><TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Button>
<Button Click="CloseWindow" AutomationProperties.Name="Close" Style="{StaticResource ChromeButton}"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Button>
</StackPanel>
</DockPanel>
<StackPanel Grid.Row="1" Margin="0,2,0,16"><Border Style="{DynamicResource Badge}"><TextBlock Text="{Binding SelectedNavigation.Section, FallbackValue=MAIN, TargetNullValue=MAIN}" Style="{DynamicResource BadgeText}"/></Border><TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeading}"/><TextBlock Text="{Binding PageSubtitle}" Style="{DynamicResource PageLead}"/></StackPanel>
<TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
<TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></ControlTemplate></TabControl.Template>
<TabItem Header="Overview"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:OverviewView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Start Meeting"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:StartMeetingView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Accounts"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:AccountsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Schedules"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:SchedulesView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Logs"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:LogsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Coordinators"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:DashboardWebView View="coordinators"/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Groups &amp; Students"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:RosterWebView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Meetings"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:MeetingsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Attendance"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:ExtensionAttendanceView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="AI Matching"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:MatchingView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Waiting Room"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:WaitingRoomView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Settings"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{DynamicResource Card}" HorizontalAlignment="Left" MaxWidth="820"><StackPanel>
<TextBlock Text="Appearance" Style="{DynamicResource CardTitle}"/><TextBlock Text="The app has one design. Pick night or day; the moon / sun button at the top does the same." Style="{DynamicResource Muted}" Margin="0,0,0,12"/><UniformGrid Columns="2" Margin="-3,0,0,18"><Button Content="&#x263E;   Night" Click="UseDarkTheme" Padding="20,14"/><Button Content="&#x263C;   Day" Click="UseLightTheme" Padding="20,14"/></UniformGrid>
<CheckBox Content="Show a soft trail behind the pointer" IsChecked="{Binding IsEffectEnabled, ElementName=GhostCursor}" Margin="0,0,0,16"/>
<TextBlock Text="Where your data is kept" Style="{DynamicResource CardTitle}"/><TextBlock Text="%LOCALAPPDATA%\ZoomAutoAdmit" FontFamily="{DynamicResource AppMono}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,22"/>
<TextBlock Text="AI key" Style="{DynamicResource CardTitle}"/><TextBlock Text="Your key lives in Windows Credential Manager, never in a file here. Nothing on this page contacts the provider." Style="{DynamicResource Muted}"/>
<Button Content="Set up the key" Command="{Binding NavigateCommand}" CommandParameter="9" HorizontalAlignment="Left" Margin="0,12"/>
<TextBlock Text="Central server" Style="{DynamicResource CardTitle}" Margin="0,14,0,0"/><TextBlock Text="Whether this PC runs the central server (backend and agent) or connects to another one. The database password lives in Windows Credential Manager." Style="{DynamicResource Muted}" TextWrapping="Wrap"/>
<Button Content="Open Server →" Command="{Binding NavigateCommand}" CommandParameter="14" HorizontalAlignment="Left" Margin="0,12"/>
<Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14" Margin="0,18,0,0"><TextBlock Text="Everything on this page is remembered for this computer only." Style="{DynamicResource Muted}"/></Border>
</StackPanel></Border></ScrollViewer></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="AI Engine"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:AiEngineView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Session Roles"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:SessionRolesView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Server"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:RecordingsDashboardView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Sessions"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:SessionsWebView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Recordings"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:CentralRecordingsView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
<TabItem Header="Dashboard"><views:LazyPage><views:LazyPage.ContentTemplate><DataTemplate><views:DashboardWebView/></DataTemplate></views:LazyPage.ContentTemplate></views:LazyPage></TabItem>
</TabControl></Grid>
<views:GhostCursorOverlay x:Name="GhostCursor" Grid.ColumnSpan="2" Panel.ZIndex="100"/>
</Grid></Border></Window>

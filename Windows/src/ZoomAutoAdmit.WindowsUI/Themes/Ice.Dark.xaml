<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Ice at night: steel blue, noticeably lighter and bluer than Midnight. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#0F1A2B"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F0142238"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6EEFB"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9DAECA"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#6C7E9B"/>
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#09FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2B3B82F6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7CB0FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2ED9A0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F4525F"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#263B82F6"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#242ED9A0"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#26F5A524"/>
    <!-- Soft tints the reference uses for status chips; they were missing here. -->
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#2638BDF8"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#26F4525F"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#26A78BFA"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#16233A"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1D2B45" Offset="0"/><GradientStop Color="#16233A" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#2563EB" Offset="1"/></LinearGradientBrush>
    <!-- The three page glows of the reference background, in its own order and strength. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#243B82F6" Offset="0"/><GradientStop Color="#003B82F6" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#1838BDF8" Offset="0"/><GradientStop Color="#0038BDF8" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 22px 60px rgba(0,0,0,.45) and 0 8px 24px rgba(0,0,0,.3). -->
    <DropShadowEffect x:Key="CardShadow" Color="#00060F" Opacity="0.4" BlurRadius="22" ShadowDepth="8" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#000000" Opacity="0.3" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#3B82F6" Opacity="0.26" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <CornerRadius x:Key="SidebarCorner">0</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="AppMono">Consolas, Cascadia Mono</FontFamily>
    <GridLength x:Key="SidebarWidth">264</GridLength>
</ResourceDictionary>

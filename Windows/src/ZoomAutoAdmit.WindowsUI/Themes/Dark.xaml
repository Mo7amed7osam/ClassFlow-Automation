<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Studio, night. The same design as Light.xaml with the same keys; only the values change. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#0D1017"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#11151D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E7EAF0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B5"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#6B7486"/>
    <SolidColorBrush x:Key="LineBrush" Color="#222835"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#323A4B"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0F131B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1B212C"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#23264A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B8FF9"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#22264A"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#12291F"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#2D2410"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#0F2433"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#301719"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#221B38"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#161B25"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#222835"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#151A23"/>
    <SolidColorBrush x:Key="CardBrush" Color="#151A23"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7477F4"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="GlowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="GlowPurpleBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="GlowGreenBrush" Color="Transparent"/>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.28" BlurRadius="14" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#000000" Opacity="0.25" BlurRadius="8" ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#6366F1" Opacity="0" BlurRadius="0" ShadowDepth="0"/>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <CornerRadius x:Key="SidebarCorner">0</CornerRadius>
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Cascadia Mono, Consolas</FontFamily>
    <GridLength x:Key="SidebarWidth">240</GridLength>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Tokens translated from the user-supplied standalone HTML, not runtime settings. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#E6EFFB"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#DBFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#12233D"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6B86"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#8494AC"/>
    <SolidColorBrush x:Key="LineBrush" Color="#17173A74"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#29173A74"/>
    <SolidColorBrush x:Key="InputBrush" Color="#E6EEF4FD"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0F2F6FE4"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1A2F6FE4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FE4"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#1F8B5CF6"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F10B981"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#21F59E0B"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#1A0EA5E9"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#1AEF4444"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#1F8B5CF6"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#E6E4EEFC"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1A173A74"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F7FAFE" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4B8BF4" Offset="0"/><GradientStop Color="#427DEB" Offset=".55"/><GradientStop Color="#3A6FE6" Offset="1"/></LinearGradientBrush>
    <!-- Light background is a white wash plus a pale blue one; no green glow. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#F2FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#D9C5DDFD" Offset="0"/><GradientStop Color="#00C5DDFD" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 18px 44px rgba(38,78,148,.10) and 0 6px 18px rgba(38,78,148,.08). -->
    <DropShadowEffect x:Key="CardShadow" Color="#264E94" Opacity="0.10" BlurRadius="22" ShadowDepth="8" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#264E94" Opacity="0.08" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#2F6FE4" Opacity="0.22" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">14,14,0,14</Thickness>
    <CornerRadius x:Key="SidebarCorner">24</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Cascadia Code, Consolas</FontFamily>
    <GridLength x:Key="SidebarWidth">278</GridLength>
</ResourceDictionary>

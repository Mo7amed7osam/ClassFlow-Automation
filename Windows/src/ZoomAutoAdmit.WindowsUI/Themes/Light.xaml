<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Studio, day. One design for the whole app: flat cards on a cool grey page, indigo accent,
         and one colour per meaning (green present/ok, amber review, red absent/error, blue info). -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6475"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#8B93A3"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E4E7EE"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#CDD3DE"/>
    <SolidColorBrush x:Key="InputBrush" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#EBEBFD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#EEF0FE"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#E6F6EF"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#FDF3E3"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#E5F3FB"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#F1EBFE"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E4E7EE"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="GlowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="GlowPurpleBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="GlowGreenBrush" Color="Transparent"/>
    <DropShadowEffect x:Key="CardShadow" Color="#0F172A" Opacity="0.05" BlurRadius="14" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#0F172A" Opacity="0.05" BlurRadius="8" ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#4F46E5" Opacity="0" BlurRadius="0" ShadowDepth="0"/>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <CornerRadius x:Key="SidebarCorner">0</CornerRadius>
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Cascadia Mono, Consolas</FontFamily>
    <GridLength x:Key="SidebarWidth">240</GridLength>
</ResourceDictionary>

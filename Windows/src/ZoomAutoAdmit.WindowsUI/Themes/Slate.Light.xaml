<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Warm slate light: cream paper with the same amber accent. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F6F0E6"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EAFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#241C13"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E6255"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#978B7C"/>
    <SolidColorBrush x:Key="LineBrush" Color="#16241C13"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#28241C13"/>
    <SolidColorBrush x:Key="InputBrush" Color="#E8F8F4ED"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#12B45309"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1FB45309"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#1FF59E0B"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F10B981"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#21F59E0B"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#1A0EA5E9"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#1AEF4444"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#1F8B5CF6"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#E8F1EBDF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1A173A74"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#FDFAF4" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#D97706" Offset="1"/></LinearGradientBrush>
    <!-- Light background is a white wash plus a pale blue one; no green glow. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#CCFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#20F59E0B" Offset="0"/><GradientStop Color="#00F59E0B" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 18px 44px rgba(38,78,148,.10) and 0 6px 18px rgba(38,78,148,.08). -->
    <DropShadowEffect x:Key="CardShadow" Color="#5B4636" Opacity="0.10" BlurRadius="22" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#264E94" Opacity="0.08" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#D97706" Opacity="0.22" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">14,14,0,14</Thickness>
    <CornerRadius x:Key="SidebarCorner">24</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Corbel, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Consolas, Cascadia Mono</FontFamily>
    <GridLength x:Key="SidebarWidth">278</GridLength>
</ResourceDictionary>

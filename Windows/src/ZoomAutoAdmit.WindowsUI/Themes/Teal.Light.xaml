<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Deep teal light: cool paper with the same mint accent. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#E6F1EF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E8FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#082B29"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#4A6B68"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#799492"/>
    <SolidColorBrush x:Key="LineBrush" Color="#16082B29"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#28082B29"/>
    <SolidColorBrush x:Key="InputBrush" Color="#E8EDF6F5"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0F0D9488"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1A0D9488"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#1F14B8A6"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F10B981"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#21F59E0B"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#1A0EA5E9"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#1AEF4444"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#1F8B5CF6"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#E8E1EFED"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1A173A74"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F5FBFA" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#14B8A6" Offset="0"/><GradientStop Color="#0D9488" Offset="1"/></LinearGradientBrush>
    <!-- Light background is a white wash plus a pale blue one; no green glow. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#C8FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#1E14B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 18px 44px rgba(38,78,148,.10) and 0 6px 18px rgba(38,78,148,.08). -->
    <DropShadowEffect x:Key="CardShadow" Color="#0B4A46" Opacity="0.09" BlurRadius="22" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#264E94" Opacity="0.08" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#0D9488" Opacity="0.2" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">14,14,0,14</Thickness>
    <CornerRadius x:Key="SidebarCorner">24</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Cascadia Mono, Consolas</FontFamily>
    <GridLength x:Key="SidebarWidth">278</GridLength>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Ice: white paper with a cool blue accent. The brightest of the four. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#E9F1FC"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EDFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0E2440"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#51647F"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#8496AE"/>
    <SolidColorBrush x:Key="LineBrush" Color="#170E2440"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#290E2440"/>
    <SolidColorBrush x:Key="InputBrush" Color="#EAEFF5FC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#102563EB"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1F2563EB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#1F2563EB"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F10B981"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#21F59E0B"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#1A0EA5E9"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#1AEF4444"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#1F8B5CF6"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#EAE3EDF8"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1A173A74"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F5F9FF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#2563EB" Offset="1"/></LinearGradientBrush>
    <!-- Light background is a white wash plus a pale blue one; no green glow. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#D8FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#242563EB" Offset="0"/><GradientStop Color="#002563EB" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 18px 44px rgba(38,78,148,.10) and 0 6px 18px rgba(38,78,148,.08). -->
    <DropShadowEffect x:Key="CardShadow" Color="#1B3A63" Opacity="0.10" BlurRadius="22" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#264E94" Opacity="0.08" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#2563EB" Opacity="0.22" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">14,14,0,14</Thickness>
    <CornerRadius x:Key="SidebarCorner">24</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="AppMono">Consolas, Cascadia Mono</FontFamily>
    <GridLength x:Key="SidebarWidth">278</GridLength>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Deep teal: a green-black base with a mint accent. The coolest, quietest dark. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#031414"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F0071E1F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#DFEFEE"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#87A6A4"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#5B7574"/>
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#09FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2B14B8A6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5EEAD4"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2ED9A0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FB7185"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#2614B8A6"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#A5F3D0"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#242ED9A0"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#26F5A524"/>
    <!-- Soft tints the reference uses for status chips; they were missing here. -->
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#2638BDF8"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#26F4525F"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#26A78BFA"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#0A2020"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#03211E"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0F2A29" Offset="0"/><GradientStop Color="#0A2020" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2DD4BF" Offset="0"/><GradientStop Color="#0D9488" Offset="1"/></LinearGradientBrush>
    <!-- The three page glows of the reference background, in its own order and strength. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#2414B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#1822D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#1034D399" Offset="0"/><GradientStop Color="#0034D399" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 22px 60px rgba(0,0,0,.45) and 0 8px 24px rgba(0,0,0,.3). -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.4" BlurRadius="22" ShadowDepth="8" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#000000" Opacity="0.3" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#14B8A6" Opacity="0.26" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <CornerRadius x:Key="SidebarCorner">0</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Cascadia Mono, Consolas</FontFamily>
    <GridLength x:Key="SidebarWidth">264</GridLength>
</ResourceDictionary>

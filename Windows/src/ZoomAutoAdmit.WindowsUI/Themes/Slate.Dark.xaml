<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Warm slate: brown-black with an amber accent. The only design with no blue in it. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#17120D"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F31E1811"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0E9DF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AFA396"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#7E7264"/>
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="StrongLineBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#09FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2BF59E0B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#84CC16"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F4525F"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#26F59E0B"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#E7B87A"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#242ED9A0"/>
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#26F5A524"/>
    <!-- Soft tints the reference uses for status chips; they were missing here. -->
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#2638BDF8"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#26F4525F"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#26A78BFA"/>
    <SolidColorBrush x:Key="InsetStrongBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardBaseBrush" Color="#221B14"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1206"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2A221A" Offset="0"/><GradientStop Color="#221B14" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FBBF24" Offset="0"/><GradientStop Color="#EA8C0B" Offset="1"/></LinearGradientBrush>
    <!-- The three page glows of the reference background, in its own order and strength. -->
    <RadialGradientBrush x:Key="GlowBrush"><GradientStop Color="#20F59E0B" Offset="0"/><GradientStop Color="#00F59E0B" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPurpleBrush"><GradientStop Color="#16E7B87A" Offset="0"/><GradientStop Color="#00E7B87A" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowGreenBrush"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
    <!-- Reference: 0 22px 60px rgba(0,0,0,.45) and 0 8px 24px rgba(0,0,0,.3). -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.42" BlurRadius="22" ShadowDepth="7" Direction="270"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#000000" Opacity="0.3" BlurRadius="14" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="PrimaryGlow" Color="#F59E0B" Opacity="0.24" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <CornerRadius x:Key="SidebarCorner">0</CornerRadius>
    <!-- Each design carries its own typeface so the four are distinct, not only recoloured. -->
    <FontFamily x:Key="AppFont">Corbel, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMono">Consolas, Cascadia Mono</FontFamily>
    <GridLength x:Key="SidebarWidth">264</GridLength>
</ResourceDictionary>

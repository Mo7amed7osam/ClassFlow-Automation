<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ZoomAutoAdmit.WindowsUI.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid Columns="4" Margin="0,0,-18,18">
            <Border Style="{DynamicResource Card}" Margin="0,0,18,0"><Grid><StackPanel><TextBlock Text="AI Confidence" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding AiMatching.ConfidenceSummary}" Style="{DynamicResource Metric}"/><TextBlock Text="Latest batch: present matches" Style="{DynamicResource Muted}"/></StackPanel><Border Background="{DynamicResource IconTileBrush}" CornerRadius="10" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#9676FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,18,0"><Grid><StackPanel><TextBlock Text="Live Sessions" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Dashboard.Sessions.Count}" Style="{DynamicResource Metric}"/><TextBlock Text="Active meetings" Style="{DynamicResource Muted}"/></StackPanel><Border Background="{DynamicResource SelectedBrush}" CornerRadius="10" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,18,0"><Grid><StackPanel><TextBlock Text="Verified admissions" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding WaitingRoom.VerifiedAdmissions}" Style="{DynamicResource Metric}"/><TextBlock Text="Recent session events" Style="{DynamicResource Muted}"/></StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="20"/></Grid></Border>
            <Border Style="{DynamicResource Card}" Margin="0,0,18,0"><Grid><StackPanel><TextBlock Text="Automation" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Dashboard.MonitoringStatus}" Style="{DynamicResource Metric}" FontSize="24"/><TextBlock Text="Desktop + Web runtime" Style="{DynamicResource Muted}"/></StackPanel><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="20"/></Grid></Border>
        </UniformGrid>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Card}" Margin="0,0,18,0" MinHeight="315"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="Live Meeting" Style="{DynamicResource CardTitle}"/><TextBlock Text="{Binding Dashboard.PrimarySession.State, TargetNullValue=IDLE, FallbackValue=IDLE}" Foreground="{DynamicResource AccentBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
                <StackPanel Grid.Row="1"><TextBlock Text="{Binding Dashboard.PrimarySession.AccountName, TargetNullValue=No active meeting, FallbackValue=No active meeting}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Dashboard.PrimarySession.AccountId, TargetNullValue=Start a meeting to begin monitoring, FallbackValue=Start a meeting to begin monitoring}" Style="{DynamicResource Muted}" Margin="0,7,0,25"/>
                    <UniformGrid Columns="3"><Border Style="{DynamicResource InsetCard}" Padding="9" Margin="0,0,5,0"><StackPanel><TextBlock Text="Engine" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Dashboard.PrimarySession.EngineType, TargetNullValue=—, FallbackValue=—}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{DynamicResource InsetCard}" Padding="9" Margin="0,0,5,0"><StackPanel><TextBlock Text="State" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Dashboard.PrimarySession.State, TargetNullValue=Idle, FallbackValue=Idle}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{DynamicResource InsetCard}" Padding="9"><StackPanel><TextBlock Text="Started" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Dashboard.PrimarySession.StartTime, StringFormat=HH:mm, TargetNullValue=—, FallbackValue=—}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
                    <TextBlock Text="{Binding Dashboard.StatusMessage}" Style="{DynamicResource Muted}" Margin="0,26,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Row="2" Margin="-3,20,0,0"><Button Content="Start meeting  →" Style="{DynamicResource PrimaryButton}" Command="{Binding ShowStartMeetingCommand}"/><Button Content="View sessions" Command="{Binding NavigateCommand}" CommandParameter="7"/></WrapPanel>
            </Grid></Border>
            <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="0,0,18,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="AI Engine Status" Style="{DynamicResource CardTitle}"/><TextBlock Text="{Binding AiMatching.Provider, StringFormat={}{0} + local name matching}" Style="{DynamicResource Muted}"/></StackPanel>
                <views:EngineGlyph Grid.Row="1" Height="148" Margin="0,5"/>
                <StackPanel Grid.Row="2"><TextBlock Text="{Binding AiMatching.Status}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/><Button Content="AI setup →" Command="{Binding NavigateCommand}" CommandParameter="12" Margin="0,8,0,0"/></StackPanel>
            </Grid></Border>
            <Border Grid.Column="2" Style="{DynamicResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Recent Activity" Style="{DynamicResource CardTitle}"/>
                <Grid Grid.Row="1"><TextBlock Text="Runtime activity will appear here."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Logs.Entries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <ListBox ItemsSource="{Binding Logs.Entries}" MaxHeight="205" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="10"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                <Button Grid.Row="2" Content="View all activity  →" Command="{Binding NavigateCommand}" CommandParameter="4" Margin="0,12,0,0"/>
            </Grid></Border>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Card}" Margin="0,0,18,0"><StackPanel><TextBlock Text="Workspace Status" Style="{DynamicResource CardTitle}"/><DockPanel Margin="0,0,0,12"><TextBlock Text="Accounts" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Accounts.Items.Count}" HorizontalAlignment="Right"/></DockPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="Groups" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Roster.Groups.Count}" HorizontalAlignment="Right"/></DockPanel><DockPanel><TextBlock Text="Storage" Style="{DynamicResource Muted}"/><TextBlock Text="Local files" HorizontalAlignment="Right" FontSize="11"/></DockPanel></StackPanel></Border>
            <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="0,0,18,0"><StackPanel><TextBlock Text="Quick Actions" Style="{DynamicResource CardTitle}"/><UniformGrid Columns="3"><Button Command="{Binding NavigateCommand}" CommandParameter="4" Padding="8,14"><StackPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,0,12"/><TextBlock Text="View Logs" FontSize="11"/></StackPanel></Button><Button Command="{Binding NavigateCommand}" CommandParameter="3" Padding="8,14"><StackPanel><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,0,12"/><TextBlock Text="Schedules" FontSize="11"/></StackPanel></Button><Button Command="{Binding NavigateCommand}" CommandParameter="9" Padding="8,14"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,0,12"/><TextBlock Text="AI Matching" FontSize="11"/></StackPanel></Button><Button Content="Accounts" Command="{Binding NavigateCommand}" CommandParameter="2" Padding="8,14"/><Button Content="Attendance" Command="{Binding NavigateCommand}" CommandParameter="8" Padding="8,14"/><Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="11" Padding="8,14"/></UniformGrid></StackPanel></Border>
            <Border Grid.Column="2" Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Current Operation" Style="{DynamicResource CardTitle}"/><TextBlock Text="{Binding Dashboard.LastAction}" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="{Binding Dashboard.CurrentOperation}" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Dashboard.ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.AutoAdmitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The admitting switch, today's tally and the controls that change how people are let in,
         gathered in one card so the state the engines actually read is visible at a glance. -->
    <Border Style="{DynamicResource Card}" MaxWidth="360" HorizontalAlignment="Left" Padding="18">
        <StackPanel>

            <!-- Header: what this is, and whether it is watching right now -->
            <DockPanel Margin="0,0,0,16">
                <Border Background="{DynamicResource SelectedBrush}" CornerRadius="10" Width="38" Height="38"
                        VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{DynamicResource Badge}" DockPanel.Dock="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmitting}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding AdmissionBadgeText}" Style="{DynamicResource BadgeText}"/>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Auto Admit" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AdmissionEngineText}" Style="{DynamicResource Muted}" FontSize="10"/>
                </StackPanel>
            </DockPanel>

            <!-- Today's tally -->
            <Border Style="{DynamicResource InsetCard}" Padding="16" Margin="0,0,0,14">
                <DockPanel>
                    <Button Content="Reset" DockPanel.Dock="Right" VerticalAlignment="Center"
                            Command="{Binding ResetAdmittedTodayCommand}"
                            ToolTip="Sets today's count back to zero. Nobody is removed from the meeting."/>
                    <StackPanel>
                        <TextBlock Text="{Binding AdmittedToday}" FontSize="34" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="PARTICIPANTS ADMITTED TODAY" Style="{DynamicResource Muted}"
                                   FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Switches, each one backed by a setting the running engines read -->
            <Border Style="{DynamicResource InsetCard}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ToggleButton Style="{DynamicResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding IsAdmitting, Mode=TwoWay}"
                                      AutomationProperties.Name="Auto admit"/>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Auto admit" FontWeight="SemiBold"/>
                            <TextBlock Text="Press admit controls as they appear" Style="{DynamicResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ToggleButton Style="{DynamicResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding PrefersAdmitAll, Mode=TwoWay}"
                                      AutomationProperties.Name="Prefer Admit all"/>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Prefer &quot;Admit all&quot;" FontWeight="SemiBold"/>
                            <TextBlock Text="One press instead of one per person" Style="{DynamicResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <ToggleButton Style="{DynamicResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowWebBrowser, Mode=TwoWay}"
                                      AutomationProperties.Name="Show the web browser"/>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Show the web browser" FontWeight="SemiBold"/>
                            <TextBlock Text="Watch a Web meeting instead of running it hidden" Style="{DynamicResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button Content="Open the runtime log" HorizontalAlignment="Stretch"
                    Style="{DynamicResource PrimaryButton}"
                    Command="{Binding NavigateCommand}" CommandParameter="4"/>

            <TextBlock Style="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"
                       Text="Open Zoom's Participants panel so the waiting-room controls exist on screen."/>

            <Separator Margin="0,14,0,10" Background="{DynamicResource LineBrush}"/>
            <TextBlock HorizontalAlignment="Center" FontSize="11">
                <Run Text="Powered by" Foreground="{DynamicResource MutedBrush}"/>
                <Run Text="Mohab Mohamed" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>

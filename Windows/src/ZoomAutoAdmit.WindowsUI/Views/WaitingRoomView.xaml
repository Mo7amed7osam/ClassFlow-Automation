<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.WaitingRoomView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ZoomAutoAdmit.WindowsUI.Views" xmlns:infra="clr-namespace:ZoomAutoAdmit.WindowsUI.Infrastructure">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<!-- The switch on the left, who it let in on the right; one under the other on a narrow window. -->
<Grid infra:Responsive.StackBelow="900" Margin="0,0,0,16">
<Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<views:AutoAdmitPanel VerticalAlignment="Top"/>
<Border Grid.Column="1" Style="{DynamicResource Card}" Margin="16,0,0,0"><StackPanel>
<DockPanel LastChildFill="False"><TextBlock DockPanel.Dock="Left" Text="People let in today" Style="{DynamicResource CardTitle}"/><Button DockPanel.Dock="Right" Content="Runtime log →" Command="{Binding NavigateCommand}" CommandParameter="4" Margin="0,-6,0,0" VerticalAlignment="Top"/></DockPanel>
<TextBlock Text="{Binding WaitingRoom.Status}" Style="{DynamicResource Muted}" Margin="0,-4,0,12"/>
<UniformGrid Columns="3" Margin="0,0,-10,0">
<Border Background="{DynamicResource GreenSoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="Admitted today" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding WaitingRoom.AdmittedToday}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border>
<Border Background="{DynamicResource CyanSoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="Different people" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding WaitingRoom.DistinctToday}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/></StackPanel></Border>
<Border Background="{DynamicResource SelectedBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="Today's counter (top bar)" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding AdmittedToday}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
</UniformGrid>
<DataGrid ItemsSource="{Binding WaitingRoom.Admitted}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="160" MaxHeight="420" Margin="0,6,0,0"><DataGrid.Columns>
<DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Admitted by" Binding="{Binding SourceText}" Width="120"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="Names are written as each admit happens, by the app and by the standalone monitor; Admit all is one row with how many it let in." Style="{DynamicResource Muted}" FontSize="11.5" Margin="0,8,0,0"/>
</StackPanel></Border>
</Grid>
<Border Style="{DynamicResource Card}" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="Active session monitors" Style="{DynamicResource CardTitle}"/>
<TextBlock Text="{Binding Dashboard.StatusMessage}" Style="{DynamicResource Muted}" Margin="0,0,0,6"/>
<DataGrid ItemsSource="{Binding Dashboard.Sessions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="70" MaxHeight="160"><DataGrid.Columns>
<DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Engine" Binding="{Binding EngineType}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="2*"/>
</DataGrid.Columns></DataGrid></StackPanel></Border>
<Border Style="{DynamicResource Card}"><StackPanel>
<TextBlock Text="What the monitor saw" Style="{DynamicResource CardTitle}"/>
<TextBlock Text="A running account of what the monitor noticed, refreshed every five seconds. The admits themselves are the list above." Style="{DynamicResource Muted}" Margin="0,0,0,6"/>
<DataGrid ItemsSource="{Binding WaitingRoom.Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="260"><DataGrid.Columns>
<DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80"/><DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="65"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
</DataGrid.Columns></DataGrid></StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>

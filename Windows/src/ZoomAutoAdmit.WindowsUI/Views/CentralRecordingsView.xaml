<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.CentralRecordingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
<Border Style="{DynamicResource Card}" Padding="12">
<Grid Margin="12" DataContext="{Binding Central}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel LastChildFill="False" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding SignedInAs}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Refresh" Style="{DynamicResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="3,2"/>
            <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="3,2"/>
        </StackPanel>
    </DockPanel>

    <!-- sign-in, when needed -->
    <Border Grid.Row="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12" MaxWidth="520" HorizontalAlignment="Left">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSignedIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
            <TextBlock Text="Sign in to the central server" FontWeight="SemiBold"/>
            <TextBlock Text="Your dashboard account: the admin sees every group; a coordinator sees their own." Style="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="Username" Style="{DynamicResource FieldLabel}"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Username"/>
            <TextBlock Text="Password" Style="{DynamicResource FieldLabel}"/>
            <PasswordBox x:Name="Password" AutomationProperties.Name="Password"/>
            <CheckBox x:Name="Remember" Content="Keep me signed in on this PC (kept by Windows)" IsChecked="True" Margin="0,8,0,0"/>
            <Button Content="Sign in" Style="{DynamicResource PrimaryButton}" Click="SignIn" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>

    <!-- summary + filters -->
    <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,10" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="Recordings" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Total}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Background="{DynamicResource GreenSoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="On the LMS" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding OnLms}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border>
        <Border Background="{DynamicResource CyanSoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="Drive link" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding DriveCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
        <Border Background="{DynamicResource OrangeSoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock Text="Zoom only" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding ZoomOnly}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></StackPanel></Border>
        <Border Background="{DynamicResource RedSoftBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="No link" Style="{DynamicResource Muted}"/><TextBlock Text="{Binding Missing}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}"/></StackPanel></Border>
    </UniformGrid>
    <WrapPanel Grid.Row="3" Margin="0,0,0,8" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
        <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox ItemsSource="{Binding GroupNames}" SelectedItem="{Binding FilterGroup}" MinWidth="170" AutomationProperties.Name="Group filter"/>
        <TextBlock Text="LMS" VerticalAlignment="Center" Margin="14,0,6,0"/><ComboBox ItemsSource="{Binding LmsFilters}" SelectedItem="{Binding FilterLms}" MinWidth="110" AutomationProperties.Name="LMS status filter"/>
        <TextBlock Text="Link" VerticalAlignment="Center" Margin="14,0,6,0"/><ComboBox ItemsSource="{Binding LinkFilters}" SelectedItem="{Binding FilterLink}" MinWidth="110" AutomationProperties.Name="Link filter"/>
    </WrapPanel>

    <!-- the list -->
    <ListBox Grid.Row="4" ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" HorizontalContentAlignment="Stretch"
             Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}" AutomationProperties.Name="Recordings">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Margin="4,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Group}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding FileName}" Style="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border Grid.Column="3" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/><Style.Triggers>
                            <DataTrigger Binding="{Binding SourceText}" Value="Drive"><Setter Property="Background" Value="{DynamicResource CyanSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding SourceText}" Value="Zoom"><Setter Property="Background" Value="{DynamicResource OrangeSoftBrush}"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding SourceText}" FontSize="11"/>
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding LmsText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Content="Attach" ToolTip="Put this link on the LMS session (left alone if it already has one, except Zoom which a Drive link replaces)." Command="{Binding DataContext.AttachCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="2,0"/>
                        <Button Content="Replace" ToolTip="Put this link on the LMS even if the session already has another one." Command="{Binding DataContext.ReplaceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="2,0"/>
                        <Button Content="Dry run" Command="{Binding DataContext.DryRunCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="2,0"/>
                        <Button Content="Cancel job" Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="2,0" Visibility="{Binding JobOpen, Converter={StaticResource Visible}}"/>
                        <Button Content="Open" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="2,0"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <!-- edit the selected one + status -->
    <StackPanel Grid.Row="5" Margin="0,10,0,0">
        <DockPanel Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
            <Button DockPanel.Dock="Right" Content="Save link" Command="{Binding SaveLinkCommand}" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Text="Link of the selected recording" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding EditLink, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recording link"/>
        </DockPanel>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Grid>
</Border>
</UserControl>

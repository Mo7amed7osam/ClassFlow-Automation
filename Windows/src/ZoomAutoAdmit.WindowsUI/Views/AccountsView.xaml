<UserControl xmlns:infra="clr-namespace:ZoomAutoAdmit.WindowsUI.Infrastructure" x:Class="ZoomAutoAdmit.WindowsUI.Views.AccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{DynamicResource Card}" Padding="12">
<Grid infra:Responsive.StackBelow="820" Margin="12" DataContext="{Binding Accounts}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedAccount}" Margin="0,0,16,0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Saved accounts">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="15" Background="{DynamicResource InputBrush}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Saved" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></DockPanel><TextBlock Text="{Binding ZoomEmail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,15"/><DockPanel><TextBlock Text="{Binding AccountId}" FontSize="11"/><TextBlock Text="{Binding PreferredEngine}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="11"/></DockPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
</ListBox>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <StackPanel Margin="0,0,0,10"><Border Style="{DynamicResource Badge}" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="ACCOUNT" Style="{DynamicResource BadgeText}"/></StackPanel></Border><TextBlock Text="Account details" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="How this account signs in, and the link it usually hosts." Style="{DynamicResource PageLead}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <TextBlock Text="Account ID" Style="{DynamicResource FieldLabel}"/><TextBox Text="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Display name" Style="{DynamicResource FieldLabel}"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Group" Style="{DynamicResource FieldLabel}"/><TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Account group" />
                        <TextBlock Text="The exact LMS and roster group this profile hosts, for example CAI5_AIS4_S7." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4" />
                        <TextBlock Text="Zoom email" Style="{DynamicResource FieldLabel}"/><TextBox Text="{Binding ZoomEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Zoom Email" />
                        <TextBlock Text="Type it exactly as Zoom shows it in its saved accounts." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4" />
                        <TextBlock Text="Zoom password" Style="{DynamicResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal"><PasswordBox x:Name="ZoomPassword" Width="260" MaxLength="512" AutomationProperties.Name="Zoom password"/><Button Content="Save password" Click="SavePassword"/><Button Content="Forget" Click="ForgetPassword"/></StackPanel>
                        <TextBlock Text="{Binding PasswordState}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4"/>
                        <TextBlock Text="Usual meeting link" Style="{DynamicResource FieldLabel}" />
                        <TextBox Text="{Binding DefaultMeetingUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default meeting URL" />
                        <TextBlock Text="Save this group's link once and it fills in by itself. Change it here whenever it changes."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4" />
                        <TextBlock Text="Browser profile" Style="{DynamicResource FieldLabel}" />
                        <TextBox Text="{Binding WebProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Web browser profile" />
                        <TextBlock Text="The folder this account is already signed in to, such as s7. Leave it empty to use the account ID. A second meeting for the same account gets its own copy."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4" />
                        <Expander Header="Advanced: stored credential reference" Margin="4">
                            <TextBox Text="{Binding CredentialReference, UpdateSourceTrigger=PropertyChanged}" />
                        </Expander>
                        <TextBlock Text="Preferred engine" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding EnginePreferences}" SelectedItem="{Binding PreferredEngine}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="New" Command="{Binding NewCommand}" />
                            <Button Style="{DynamicResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" />
                            <Button Content="Switch Account" Command="{Binding SwitchAccountCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,10" />
                    </StackPanel></ScrollViewer>
</Grid>
</Border>
</UserControl>

<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.AttendanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
<BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
<!-- The two view buttons are one segmented control, so they are drawn as one: a shared track
     with the chosen half filled in. The app's Button style is not templated for that. -->
<Style x:Key="Segment" TargetType="Button">
<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
<Setter Property="FontSize" Value="12"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Padding" Value="18,6"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="SnapsToDevicePixels" Value="True"/>
<Setter Property="Background" Value="Transparent"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<!-- The selected half is filled by the DataTrigger on the button itself, so the fill has to
     follow the button's own Background rather than a fixed colour. -->
<Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
</ControlTemplate></Setter.Value></Setter>
</Style>
</UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Style="{DynamicResource Card}" Margin="0,0,0,16"><StackPanel>

<!-- Which session, and the picker for any other one. A session names its own group, so nothing
     else has to be chosen before the list below is right. -->
<Grid Margin="0,0,0,14">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
<TextBlock Text="{Binding Attendance.SessionTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Attendance.SessionSubtitle}" Style="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
<ComboBox Width="300" ItemsSource="{Binding Attendance.Sessions}" SelectedItem="{Binding Attendance.SelectedSession, Mode=TwoWay}"
          DisplayMemberPath="Title" IsEnabled="{Binding Attendance.IsIdle}" AutomationProperties.Name="Session"/>
<Button Content="Refresh" Command="{Binding Attendance.RefreshCommand}" Margin="8,0,0,0" IsEnabled="{Binding Attendance.IsIdle}"/>
<Button Content="Read now" Command="{Binding Attendance.CaptureCommand}" Margin="6,0,0,0" IsEnabled="{Binding Attendance.IsIdle}"
        ToolTip="Read the participants list of the running meeting right now."/>
<Button Content="Delete..." Command="{Binding Attendance.DeleteSessionsCommand}" Margin="6,0,0,0" IsEnabled="{Binding Attendance.IsIdle}"
        ToolTip="Remove old sessions, and the readings behind them, from this computer."/>
</StackPanel>
</Grid>
<TextBlock Text="{Binding Attendance.Status}" Style="{DynamicResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>

<!-- Nothing has been run yet. -->
<StackPanel Margin="0,34,0,20" Visibility="{Binding Attendance.HasNoSummary, Converter={StaticResource BoolToVisibility}}">
<TextBlock Text="No attendance yet" HorizontalAlignment="Center" FontWeight="SemiBold"/>
<TextBlock Text="Run a session and who attended it is recorded here by itself." HorizontalAlignment="Center"
           Style="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/>
</StackPanel>

<StackPanel Visibility="{Binding Attendance.HasSummary, Converter={StaticResource BoolToVisibility}}">

<!-- Three counts, equal width, each tinted with the colour its rows carry in the list below. -->
<UniformGrid Columns="3" Margin="0,12,0,16">
<Border CornerRadius="12" Padding="16,14" Margin="0,0,10,0" Background="{DynamicResource GreenSoftBrush}"
        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel>
<TextBlock Text="{Binding Attendance.PresentCount}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
<TextBlock Text="Present" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/></StackPanel></Border>
<Border CornerRadius="12" Padding="16,14" Margin="5,0,5,0" Background="{DynamicResource OrangeSoftBrush}"
        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel>
<TextBlock Text="{Binding Attendance.NeedsReviewCount}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
<TextBlock Text="Needs review" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/></StackPanel></Border>
<Border CornerRadius="12" Padding="16,14" Margin="10,0,0,0" Background="{DynamicResource RedSoftBrush}"
        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel>
<TextBlock Text="{Binding Attendance.NotSeenCount}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
<TextBlock Text="Not seen yet" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,0"/></StackPanel></Border>
</UniformGrid>

<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource TrackBrush}" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal">
<Button Content="Review" Command="{Binding Attendance.ShowReviewCommand}">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource Segment}"><Style.Triggers>
<DataTrigger Binding="{Binding Attendance.IsReviewOrder}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger>
</Style.Triggers></Style></Button.Style></Button>
<Button Content="Roster order" Command="{Binding Attendance.ShowRosterOrderCommand}">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource Segment}"><Style.Triggers>
<DataTrigger Binding="{Binding Attendance.IsRosterOrder}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger>
</Style.Triggers></Style></Button.Style></Button>
</StackPanel></Border>
<Grid Grid.Column="2"><TextBox Text="{Binding Attendance.SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search attendance" Margin="0"/>
<TextBlock Text="Search" Margin="12,9" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
<TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Attendance.SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
</Grid>

<ItemsControl ItemsSource="{Binding Attendance.Groups}"><ItemsControl.ItemTemplate><DataTemplate>
<StackPanel Margin="0,0,0,16">
<!-- A tinted pill rather than coloured text on the page's own background: the same colour
     reads calmly here, where a bare amber or red word does not. -->
<Border HorizontalAlignment="Left" CornerRadius="20" Padding="12,4" Margin="0,0,0,10">
<Border.Style><Style TargetType="Border">
<Setter Property="Background" Value="{DynamicResource InsetStrongBrush}"/>
<Style.Triggers>
<DataTrigger Binding="{Binding Tint}" Value="Present"><Setter Property="Background" Value="{DynamicResource GreenSoftBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NeedsReview"><Setter Property="Background" Value="{DynamicResource OrangeSoftBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NotSeen"><Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Unmatched"><Setter Property="Background" Value="{DynamicResource PurpleSoftBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Absent"><Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/></DataTrigger>
</Style.Triggers></Style></Border.Style>
<TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="11.5">
<TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers>
<DataTrigger Binding="{Binding Tint}" Value="Present"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NeedsReview"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NotSeen"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Unmatched"><Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Absent"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
</Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
<ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Style="{DynamicResource InsetCard}" Margin="0,0,0,7" Padding="0,12,14,12"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<!-- A bar rather than a dot: it carries the row's colour down the whole name, so the list
     can be read by colour alone from across the room. -->
<Rectangle Width="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Stretch">
<Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Fill" Value="{DynamicResource MutedBrush}"/><Style.Triggers>
<DataTrigger Binding="{Binding Tint}" Value="Present"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NeedsReview"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NotSeen"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Unmatched"><Setter Property="Fill" Value="{DynamicResource PurpleBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Absent"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
</Style.Triggers></Style></Rectangle.Style></Rectangle>
<StackPanel Grid.Column="1" Margin="4,0,0,0">
<!-- The name is the thing being read, so it is heavier and larger than anything around it,
     and carries a soft halo in its own colour: one word, two tones. -->
<TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap"
           Foreground="{DynamicResource TextBrush}">
<TextBlock.Style><Style TargetType="TextBlock">
<Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.22" Color="#8494AC"/></Setter.Value></Setter>
<Style.Triggers>
<DataTrigger Binding="{Binding Tint}" Value="Present"><Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="11" Opacity="0.42" Color="#34D399"/></Setter.Value></Setter></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NeedsReview"><Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="11" Opacity="0.38" Color="#FBBF24"/></Setter.Value></Setter></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="NotSeen"><Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="11" Opacity="0.38" Color="#F87171"/></Setter.Value></Setter></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Unmatched"><Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="11" Opacity="0.42" Color="#A78BFA"/></Setter.Value></Setter></DataTrigger>
<DataTrigger Binding="{Binding Tint}" Value="Absent"><Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="11" Opacity="0.38" Color="#F87171"/></Setter.Value></Setter></DataTrigger>
</Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Text="{Binding Detail}" Style="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
<TextBlock Text="{Binding Percent}" Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
<Button Content="Match..." Padding="12,5" Margin="2,0" FontSize="12"
        Command="{Binding DataContext.Attendance.RowMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
        Visibility="{Binding CanMatch, Converter={StaticResource BoolToVisibility}}"/>
<Button Content="Absent" Padding="12,5" Margin="2,0" FontSize="12"
        Command="{Binding DataContext.Attendance.RowAbsentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
        Visibility="{Binding CanMarkAbsent, Converter={StaticResource BoolToVisibility}}"/>
<Button Content="Clear" Padding="12,5" Margin="2,0" FontSize="12"
        Command="{Binding DataContext.Attendance.RowClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
        Visibility="{Binding CanClear, Converter={StaticResource BoolToVisibility}}"/>
<Button Content="Assign to student..." Padding="12,5" Margin="2,0" FontSize="12"
        Command="{Binding DataContext.Attendance.RowAssignCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
        Visibility="{Binding CanAssign, Converter={StaticResource BoolToVisibility}}"/>
</StackPanel>
</Grid></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

<Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding Attendance.EvidenceText}" Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
<WrapPanel Grid.Column="1" HorizontalAlignment="Right" Margin="-3,0,0,0">
<Button Content="Match again" Command="{Binding Attendance.MatchCommand}" IsEnabled="{Binding Attendance.IsIdle}"/>
<Button Content="Copy full list" Command="{Binding Attendance.CopyListCommand}"/>
<Button Content="Export CSV..." Command="{Binding Attendance.ExportCsvCommand}"/>
<Button Content="Finalize attendance" Command="{Binding Attendance.FinalizeCommand}" Style="{DynamicResource PrimaryButton}"/>
</WrapPanel></Grid>

</StackPanel>
</StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>

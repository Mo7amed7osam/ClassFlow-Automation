<UserControl xmlns:infra="clr-namespace:ZoomAutoAdmit.WindowsUI.Infrastructure" x:Class="ZoomAutoAdmit.WindowsUI.Views.SessionRolesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SessionRoles}">
<Border Style="{DynamicResource Card}" Margin="0,0,0,16"><StackPanel>
<StackPanel Margin="0,0,0,14"><Border Style="{DynamicResource Badge}" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="ROLES" Style="{DynamicResource BadgeText}"/></StackPanel></Border><TextBlock Text="Session roles" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="The instructor names that should be made co-host in each kind of session." Style="{DynamicResource PageLead}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
<TextBlock Text="Set this once per session type. You never pick people meeting by meeting." Style="{DynamicResource Muted}" Margin="0,8,0,0"/>
<TextBlock Text="Names do not have to be exact: when a Zoom display name does not match, the AI is asked to confirm which of these people it is. It can only choose from the people you listed here — it can never add someone new — and a low-confidence answer is logged as a suggestion instead of being assigned." Style="{DynamicResource Muted}" Margin="0,4,0,0"/>
<TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Border>

<Border Style="{DynamicResource Card}" Margin="0,0,0,16">
<Grid infra:Responsive.StackBelow="820" Margin="4" MinHeight="420">
<Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,16,0">
  <TextBlock Text="Session types" Style="{DynamicResource CardTitle}"/>
  <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="220" MaxHeight="320" AutomationProperties.Name="Session types">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4">
      <TextBlock Text="{Binding SessionType}" FontWeight="SemiBold" FontSize="14"/>
      <!-- The same type can be set up once per group, so the group is what tells them apart. -->
      <TextBlock Text="{Binding Scope}" Style="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding People.Count, StringFormat=({0} people)}" Style="{DynamicResource Muted}" FontSize="11"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Margin="0,8,0,0">
    <Button Content="New type" Command="{Binding NewCommand}"/>
    <Button Content="Delete" Command="{Binding DeleteCommand}"/>
    <Button Content="Reload" Command="{Binding ReloadCommand}"/>
  </WrapPanel>
</StackPanel>

<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Profile details" Style="{DynamicResource CardTitle}"/>
  <TextBlock Text="Session type" Style="{DynamicResource FieldLabel}"/>
  <!-- Typeable on purpose: the list holds the types that actually run, and anything else is
       simply written in rather than being unavailable. -->
  <ComboBox IsEditable="True" ItemsSource="{Binding SessionTypeOptions}"
            Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="Session type name"/>
  <TextBlock Text="Pick one of the types that run, or type another." Style="{DynamicResource Muted}" FontSize="11" Margin="4,4,0,0"/>
  <TextBlock Text="Words in the schedule name that mean this type" Style="{DynamicResource FieldLabel}"/>
  <TextBox Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Session type keywords"/>
  <TextBlock Text="Account or group that always means this type" Style="{DynamicResource FieldLabel}"/>
  <!-- One box, not a box plus a picker plus a button: the saved accounts are the list, and it
       still takes typing for a group that is not saved here, or a comma-separated few. -->
  <ComboBox IsEditable="True" ItemsSource="{Binding AvailableAccounts}"
            Text="{Binding Accounts, UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="Profile accounts"/>
  <TextBlock Text="Instructor / co-host names — one per line" Style="{DynamicResource FieldLabel}"/>
  <TextBox Text="{Binding CoHosts, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="130" MaxHeight="240" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Co-host candidates"/>
  <TextBlock Text="Example:&#x0a;Ahmed Mohamed | Ahmed M, A. Mohamed&#x0a;Assistant One" Style="{DynamicResource Muted}" Margin="4,4,0,0"/>
  <WrapPanel Margin="0,10,0,0">
    <Button Content="Save profile" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButton}"/>
  </WrapPanel>
  <TextBlock Text="{Binding StorePath, StringFormat=Saved in {0}}" Style="{DynamicResource Muted}" Margin="4,10,0,0" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer>
</Grid>
</Border>

<Border Style="{DynamicResource Card}"><StackPanel>
<TextBlock Text="Remembered assignments" Style="{DynamicResource CardTitle}"/>
<TextBlock Text="Learned from previous sessions: the Zoom display name that was matched to a configured person. Used before any AI call." Style="{DynamicResource Muted}" Margin="0,0,0,10"/>
<DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="80" MaxHeight="220"><DataGrid.Columns>
<DataGridTextColumn Header="Session type" Binding="{Binding SessionType}" Width="*"/>
<DataGridTextColumn Header="Person" Binding="{Binding PersonName}" Width="2*"/>
<DataGridTextColumn Header="Zoom name seen" Binding="{Binding ObservedName}" Width="2*"/>
<DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
<DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="*"/>
<DataGridTextColumn Header="When" Binding="{Binding AssignedAt, StringFormat=g}" Width="2*"/>
</DataGrid.Columns></DataGrid>
</StackPanel></Border>
</StackPanel></ScrollViewer>
</UserControl>

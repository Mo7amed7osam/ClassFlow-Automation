<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.MeetingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{DynamicResource Card}" Padding="12">
<Grid Margin="12" DataContext="{Binding Dashboard}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,0,0"><Border Style="{DynamicResource Badge}" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="LIVE" Style="{DynamicResource BadgeText}"/></StackPanel></Border><TextBlock Text="Active sessions" FontSize="19" FontWeight="Bold"/><TextBlock Text="Meetings running right now, and the engine each one uses." Style="{DynamicResource PageLead}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <Button DockPanel.Dock="Left" Style="{DynamicResource PrimaryButton}" Content="Start meeting" VerticalAlignment="Top" Margin="16,2,3,0" Command="{Binding DataContext.ShowStartMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button DockPanel.Dock="Left" Content="Refresh" VerticalAlignment="Top" Margin="3,2,3,0" Command="{Binding RefreshCommand}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="10,9,0,0" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Last action" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastAction}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Current operation" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentOperation}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
<ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Active meeting sessions">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Border CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
<Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource IconTileBrush}"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding AccountName}" FontWeight="SemiBold"/><TextBlock Text="{Binding AccountId}" Style="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel>
<TextBlock Grid.Column="2" Text="{Binding EngineType}" VerticalAlignment="Center"/>
<Border Grid.Column="3" Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/></Border>
<TextBlock Grid.Column="4" Text="{Binding StartTime, StringFormat=HH:mm}" VerticalAlignment="Center"/>
<Button Grid.Column="5" Content="Stop" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="10,7" VerticalAlignment="Center"/>
</Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="No active meetings. Start a meeting to see its session here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</Grid>
                </Grid>
</Border>
</UserControl>

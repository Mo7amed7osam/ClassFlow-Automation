<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.StartMeetingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{DynamicResource Card}" Padding="12">
<Grid Margin="20" DataContext="{Binding StartMeeting}" MaxWidth="680" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Account" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="DisplayName" AutomationProperties.Name="Meeting account" />
                    <TextBlock Grid.Row="1" Text="Meeting URL" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MeetingUrl, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Meeting URL" ToolTip="Loaded from Accounts. Edit here for this launch only; save permanent changes in Accounts." />
                    <TextBlock Grid.Row="2" Text="Engine preference" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EnginePreferences}" SelectedItem="{Binding EnginePreference}" />
                    <Button Grid.Row="3" Grid.Column="1" Content="Start Meeting" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"
                            Command="{Binding StartCommand}" />
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="4,12" />
                    <!-- Starting the class means two things: the Zoom meeting, and the session on
                         the dashboard. They belong on the same page. -->
                    <Expander Grid.Row="5" Grid.ColumnSpan="2" Header="LMS dashboard — start the session there too"
                              Margin="4,4,4,0" DataContext="{Binding DataContext.Lms, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel Margin="4,10,4,4">
                            <TextBlock Text="Dashboard email" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dashboard email"/>
                            <TextBlock Text="Password" Style="{DynamicResource FieldLabel}"/>
                            <PasswordBox x:Name="LmsPassword" AutomationProperties.Name="Dashboard password"/>
                            <TextBlock Text="Kept by Windows for this user account only. It is never written to the app files or the log."
                                       Style="{DynamicResource Muted}" FontSize="11" Margin="4,4,4,8"/>
                            <WrapPanel>
                                <!-- The code-behind reads the PasswordBox and clears it; a binding
                                     would keep the password alive in the binding system. -->
                                <Button Content="Save sign-in" Click="SaveLmsLogin"/>
                                <Button Content="Forget it" Command="{Binding ForgetLoginCommand}" Margin="8,0,0,0"/>
                            </WrapPanel>
                            <DockPanel Margin="4,14,4,0">
                                <ToggleButton Style="{DynamicResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding RunOnMeetingStart, Mode=TwoWay}"
                                              AutomationProperties.Name="Run the dashboard session when a meeting starts"/>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Run the session when a meeting starts" FontWeight="SemiBold"/>
                                    <TextBlock Text="The group is the meeting's account, and the class is picked by today's date and its time."
                                               Style="{DynamicResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Status}" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                        </StackPanel>
                    </Expander>
                    <Expander Grid.Row="6" Grid.ColumnSpan="2" Header="Add one — save a new account" Margin="4,4,4,0">
                        <StackPanel Margin="4,10,4,4">
                            <TextBlock Text="Account ID — one word, and permanent" Style="{DynamicResource FieldLabel}" />
                            <TextBox Text="{Binding NewAccountId, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="New account ID" />
                            <TextBlock Text="Display name — optional" Style="{DynamicResource FieldLabel}" />
                            <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="New account display name" />
                            <TextBlock Text="Zoom email" Style="{DynamicResource FieldLabel}" />
                            <TextBox Text="{Binding NewZoomEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="New account Zoom email" />
                            <TextBlock Text="Usual meeting link — optional" Style="{DynamicResource FieldLabel}" />
                            <TextBox Text="{Binding NewDefaultMeetingUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="512" AutomationProperties.Name="New account default meeting URL" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save account" Style="{DynamicResource PrimaryButton}" Command="{Binding AddAccountCommand}" />
                                <Button Content="Clear" Command="{Binding ClearNewAccountCommand}" />
                            </StackPanel>
                            <TextBlock Text="This saves to the same list the Accounts page shows. No password is kept."
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,6,4,0" />
                            <TextBlock Text="{Binding AddAccountStatus}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentBrush}" Margin="4,8,4,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Expander>
                </Grid>
</Border>
</UserControl>

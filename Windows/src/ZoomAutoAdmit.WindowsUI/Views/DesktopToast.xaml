<Window x:Class="ZoomAutoAdmit.WindowsUI.Views.DesktopToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="Height" Width="380" ResizeMode="NoResize" Title="Zoom Auto Admit">
  <Border x:Name="Frame" CornerRadius="14" Padding="16,14" Margin="10" Background="#F00E1523" BorderBrush="#24FFFFFF" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="24" ShadowDepth="6" Direction="270"/></Border.Effect>
    <DockPanel>
      <Border x:Name="Accent" DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="#6F9DFF" Margin="0,2,12,2"/>
      <Button DockPanel.Dock="Right" Content="✕" Click="CloseClicked" Background="Transparent" BorderThickness="0"
              Foreground="#9AA6BD" Padding="6,0" VerticalAlignment="Top" Cursor="Hand" FontSize="12"/>
      <StackPanel>
        <TextBlock x:Name="TitleText" Foreground="#E8EDF7" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Foreground="#9AA6BD" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>

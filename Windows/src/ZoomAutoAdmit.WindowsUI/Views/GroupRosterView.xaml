<UserControl x:Class="ZoomAutoAdmit.WindowsUI.Views.GroupRosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Three columns that each own one job: choose a group, order its students, edit one student.
      The page used to be a single flat grid, so labels sat on the fields above them and the
      status line was pushed off the bottom of the card.
    -->
    <Grid Margin="4">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Groups -->
            <Border Style="{DynamicResource InsetCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Groups" Style="{DynamicResource CardTitle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <TextBox Text="{Binding GroupSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                     AutomationProperties.Name="Search groups"/>
                            <TextBlock Text="Search groups" Margin="11,7" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding GroupSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single"
                              MinHeight="150" AutomationProperties.Name="Roster groups">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Students" Binding="{Binding Students.Count}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="Group ID" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding HasGroup}" Margin="0,0,0,2"
                                 AutomationProperties.Name="Group ID"/>
                        <TextBlock Text="Permanent once the group is saved." Style="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,4"/>
                        <TextBlock Text="Display name" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 AutomationProperties.Name="Group display name"/>
                        <WrapPanel Margin="-3,0,0,0">
                            <Button Content="New" Command="{Binding NewGroupCommand}"/>
                            <Button Content="Save" Command="{Binding SaveGroupCommand}"/>
                            <Button Content="Open" Command="{Binding RefreshCommand}"/>
                            <Button Content="Delete" Command="{Binding DeleteGroupCommand}" IsEnabled="{Binding HasGroup}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Students in the open group -->
            <!-- Importing needs a group to import into, so this whole column is disabled until
                 one is open. Without a word of explanation a greyed-out Import button reads as
                 broken, so the reason sits on top of it. -->
            <TextBlock Grid.Column="1" Panel.ZIndex="1" Margin="0,0,12,0"
                       Text="Select a group on the left to see its students and import a roster."
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <!-- The theme dictionaries are merged at runtime, so a BasedOn StaticResource
                         cannot see them; the two properties are set directly instead. -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasGroup}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Column="1" Style="{DynamicResource InsetCard}" Margin="0,0,12,0" IsEnabled="{Binding HasGroup}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedGroup.DisplayName, TargetNullValue=Open a group to see its students}"
                                   Style="{DynamicResource CardTitle}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Students keep the order you give them here. They are never sorted alphabetically."
                                   Style="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Import CSV or Excel" Command="{Binding ImportCommand}" Margin="8,0,0,0"/>
                            <Grid>
                                <TextBox Text="{Binding StudentSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                         AutomationProperties.Name="Search group students"/>
                                <TextBlock Text="Search students" Margin="11,7" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding StudentSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single"
                              MinHeight="150" AutomationProperties.Name="Ordered group students">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="50"/>
                            <DataGridTextColumn Header="Student" Binding="{Binding FullName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="-3,10,0,0">
                        <Button Content="Add student" Command="{Binding NewStudentCommand}"/>
                        <Button Content="Move up" Command="{Binding MoveUpCommand}"/>
                        <Button Content="Move down" Command="{Binding MoveDownCommand}"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- One student -->
            <Border Grid.Column="2" Style="{DynamicResource InsetCard}" IsEnabled="{Binding HasGroup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Student" Style="{DynamicResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Student ID" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding StudentId, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Group student ID"/>
                        <TextBlock Text="Position in the roster" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Student order"/>
                        <TextBlock Text="Full name" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Group student full name"/>
                        <TextBlock Text="Other names they use" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Student aliases"/>
                        <TextBlock Text="One per line. These help match the name Zoom shows." Style="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,4"/>
                        <TextBlock Text="Email" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Student email"/>
                        <WrapPanel Margin="-3,8,0,0">
                            <Button Content="Save student" Command="{Binding SaveStudentCommand}" Style="{DynamicResource PrimaryButton}"/>
                            <Button Content="Delete" Command="{Binding DeleteStudentCommand}"/>
                        </WrapPanel>
                        <Border Style="{DynamicResource StatusPill}" Background="{DynamicResource InputBrush}" HorizontalAlignment="Stretch"
                                CornerRadius="10" Padding="10,8" Margin="0,14,0,0">
                            <TextBlock Text="Importing needs two columns: the position and the name. IDs are made for you, and an order number you already have is never overwritten."
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                   Margin="4,10,4,2" AutomationProperties.Name="Group roster status"/>
    </Grid>
</UserControl>

<UserControl xmlns:infra="clr-namespace:ZoomAutoAdmit.WindowsUI.Infrastructure" x:Class="ZoomAutoAdmit.WindowsUI.Views.AiEngineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ZoomAutoAdmit.WindowsUI.Views">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Grid infra:Responsive.StackBelow="820" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{DynamicResource Card}" Margin="0,0,18,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="AI Engine" Style="{DynamicResource PageTitle}"/><TextBlock Text="Your configured model and connection status." Style="{DynamicResource Muted}" Margin="0,8,0,24"/>
<Border Style="{DynamicResource StatusPill}"><TextBlock Text="{Binding AiMatching.Provider}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
<TextBlock Text="{Binding AiMatching.Model}" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap"/>
<TextBlock Text="{Binding AiMatching.Status}" Style="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
<WrapPanel Margin="-3,20,0,0"><Button Content="Configure API key" Style="{DynamicResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="9"/><Button Content="Test saved connection" Command="{Binding AiMatching.TestSavedCommand}" IsEnabled="{Binding AiMatching.IsIdle}" AutomationProperties.Name="Test saved AI connection"/></WrapPanel>
</StackPanel><views:EngineGlyph Grid.Column="1" Width="150" VerticalAlignment="Center"/></Grid></Border>
<Border Grid.Column="1" Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Connection &amp; security" Style="{DynamicResource CardTitle}"/>
<Border Style="{DynamicResource InsetCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Connection validated" Style="{DynamicResource Muted}"/><TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Not validated"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding AiMatching.IsReady}" Value="True"><Setter Property="Text" Value="Validated"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
<TextBlock Text="{Binding AiMatching.HasSavedKey, StringFormat=Saved key available: {0}}" Style="{DynamicResource Muted}"/><TextBlock Text="Keys stay in Windows Credential Manager. Tests send a synthetic name; API charges may apply." Style="{DynamicResource Muted}" Margin="0,16,0,0"/>
</StackPanel></Border></Grid>
<Border Style="{DynamicResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Matching pipeline" Style="{DynamicResource CardTitle}"/>
<UniformGrid Columns="3"><Border Style="{DynamicResource InsetCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="01  Normalize &amp; match" FontWeight="SemiBold"/><TextBlock Text="Existing name rules and approved aliases." Style="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{DynamicResource InsetCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="02  Resolve uncertainty" FontWeight="SemiBold"/><TextBlock Text="External matching only with your permission." Style="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{DynamicResource InsetCard}"><StackPanel><TextBlock Text="03  Review results" FontWeight="SemiBold"/><TextBlock Text="Roster order is preserved. No absence calculation." Style="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
<WrapPanel Margin="-3,18,0,0"><Button Content="Open AI Matching →" Command="{Binding NavigateCommand}" CommandParameter="9"/><Button Content="View runtime logs →" Command="{Binding NavigateCommand}" CommandParameter="4"/></WrapPanel>
</StackPanel></Border>
<Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Advanced tools" Style="{DynamicResource CardTitle}"/><TextBlock Text="These reference-design tools are not implemented. Existing matching and admission rules are unchanged." Style="{DynamicResource Muted}"/>
<WrapPanel Margin="-3,12,0,0"><Button Content="View usage" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Provider usage reporting is not implemented."/><Button Content="Manage weights" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Matching rule configuration is not exposed by the existing service."/></WrapPanel>
</StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>

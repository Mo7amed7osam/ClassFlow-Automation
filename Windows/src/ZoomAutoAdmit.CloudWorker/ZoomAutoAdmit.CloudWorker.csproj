<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 only, and deliberately: this is the half that runs where there is no Windows. A
         reference that drags a Windows-only project in will not compile, which is the point. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZoomAutoAdmit.CloudWorker</RootNamespace>
    <AssemblyName>ZoomAutoAdmit.CloudWorker</AssemblyName>
    <!-- Not invariant: without ICU, TimeZoneInfo cannot resolve an IANA id such as Africa/Cairo,
         and the class times this worker exists to keep are written in one. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The container has no user to answer a prompt, so an unobserved failure must be loud. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoomAutoAdmit.CentralAgent\ZoomAutoAdmit.CentralAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Directly, although WebAutomation already brings it: the package's own targets copy the
         .playwright driver (node and the browser registry) into the output of the project that
         names it, and a transitive reference does not get that. Without this the worker publishes
         without a driver and answers "missing required assets" the first time it opens a page. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZoomAutoAdmit.CloudWorker.Tests" />
  </ItemGroup>

</Project>
